---
// Polices auto-hébergées : pas de requête tierce, pas de FOUT.
import '@fontsource/anton';
import '@fontsource-variable/nunito';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import type { Langue } from '../i18n';
import Cookies from '../components/Cookies.astro';

interface Props {
  title?: string;
  description?: string;
  /** Page outil : à tenir hors des résultats de recherche. */
  noindex?: boolean;
  langue?: Langue;
  /** Pour une page traduite : son adresse dans chaque langue. */
  chemins?: Record<Langue, string>;
  /** Image de partage (1200 × 630, dans public/og/). Par défaut, celle du lieu. */
  image?: string;
}

// `base` est pris en compte : les chemins absolus doivent en tenir compte.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const descriptions: Record<Langue, string> = {
  fr: "Coffee Shop & Brunch Healthy au 94 rue Saint-André, dans le Vieux-Lille.",
  en: 'Coffee shop & healthy brunch at 94 rue Saint-André, in Vieux-Lille (Old Lille).',
};

const {
  title = 'LÜM — Vieux-Lille',
  langue = 'fr',
  description = descriptions[langue],
  noindex = false,
  chemins,
  image = '/og/lum.png',
} = Astro.props;

// Le domaine vient de `site` dans astro.config.mjs : une seule source.
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://lumvieuxlille.fr';

// Adresse canonique : celle de la page, sans paramètres (utm, orderId…).
const canonique = siteUrl + Astro.url.pathname;
const imageUrl = siteUrl + image;

// Chaque version annonce l'autre aux moteurs de recherche ; le français est
// la version par défaut, pour les visiteurs d'aucune des deux langues.
const alternates = chemins
  ? [
      ...Object.entries(chemins).map(([l, chemin]) => ({ hreflang: l, href: siteUrl + chemin })),
      { hreflang: 'x-default', href: siteUrl + chemins.fr },
    ]
  : [];

// Fiche établissement pour les moteurs de recherche. N'y figure que ce qui
// est fourni par la boutique : une valeur inventée dans un balisage structuré
// se retrouve telle quelle dans les résultats de recherche (et dans les
// réponses des assistants IA). La description est celle du lieu, la même sur
// toutes les pages : celle de la page ne décrit pas l'établissement.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': `${siteUrl}/#cafe`,
  name: 'LÜM Vieux-Lille',
  description: descriptions[langue],
  url: siteUrl,
  // Visuel de marque, faute de photo hébergée : à remplacer par une photo du
  // lieu dès qu'il y en a une sur le site.
  image: `${siteUrl}/og/lum.png`,
  // Format E.164 : sans espaces, c'est ce qui rend l'appel cliquable partout.
  telephone: '+33642996242',
  // Du simple espresso à la formule brunch (src/data/menu.ts, Brunch.astro).
  priceRange: '2,50 € – 25 €',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '94 rue Saint-André',
    postalCode: '59800',
    addressLocality: 'Lille',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 50.645346,
    longitude: 3.0567,
  },
  // Ouvert du mercredi au lundi : le mardi est fermé, donc absent de la liste.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  servesCuisine: ['Coffee', 'Brunch'],
  hasMenu: `${siteUrl}/menu`,
  sameAs: [
    'https://www.instagram.com/lum_vieuxlille',
    'https://www.tiktok.com/@lum_vieuxlille',
  ],
};
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="canonical" href={canonique} />
    <title>{title}</title>
    <!-- Aperçu des liens partagés (WhatsApp, Messenger, iMessage, réseaux…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LÜM Vieux-Lille" />
    <meta property="og:locale" content={langue === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:url" content={canonique} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Consentement et mesure d'audience GA4 (src/scripts/mesure.ts) -->
    <Cookies langue={langue} />

    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "49bf6d7e8ddf43379c8938c63093b8cc"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>

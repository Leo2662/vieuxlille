---
// Polices auto-hébergées : pas de requête tierce, pas de FOUT.
import '@fontsource/anton';
import '@fontsource-variable/nunito';
import '@fontsource/caveat/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

// `base` est pris en compte : les chemins absolus doivent en tenir compte.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title = 'LÜM — Vieux-Lille',
  description =
    "Coffee Shop & Brunch Healthy au 94 rue Saint-André, dans le Vieux-Lille.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChoixLangue from './ChoixLangue.astro';
import { chemins, type Langue } from '../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;

const RESERVATION = 'https://lumvieuxlille-hash.github.io/lum-vieuxlille/';

const adresses = chemins('brunch/');
const accueil = chemins('')[langue];

// Pictogrammes au trait des trois espaces, communs aux deux langues.
const TRACES = {
  // Parasol et sa table
  terrasse:
    'M6 22C6 12.6 14 6 24 6s18 6.6 18 16 M6 22c3-2.2 6-2.2 9 0s6 2.2 9 0 6-2.2 9 0 6 2.2 9 0 M24 22v20 M24 6V3 M14 32h20 M17 42h14',
  // Suspension au-dessus d'une table
  interieur: 'M24 3v8 M15 19l4-8h10l4 8z M10 30h28 M14 30v12 M34 30v12',
  // Voûte de pierre, ses claveaux et le sol
  cave: 'M7 43V24a17 17 0 0 1 34 0v19 M15 43V24a9 9 0 0 1 18 0v19 M24 7v8 M12 12l5.7 5.7 M36 12l-5.7 5.7 M3 43h42',
};

// Paquet cadeau et son nœud, pour l'encart carte cadeau.
const CADEAU =
  'M9 21h30v21H9z M6 14h36v7H6z M24 14v28 M24 14c-2.5-6.5-11-9-11-3.5 0 3.5 6 3.5 11 3.5 M24 14c2.5-6.5 11-9 11-3.5 0 3.5-6 3.5-11 3.5';

// La commande d'une carte cadeau n'existe qu'en français (comme l'afterwork).
const CARTE_CADEAU = '/brunch/carte-cadeau/';

// Une formule à prix unique : on choisit une option dans chaque bloc.
// Prix, horaires, options et espaces sont redits dans public/llms.txt : à
// modifier ensemble, dans les deux langues. Les espaces insécables ( )
// évitent qu'un mot reste seul en fin de ligne.
const textes = {
  fr: {
    titre: 'Brunch Vieux-Lille — LÜM, terrasse et cave voûtée',
    description:
      'Brunch dans le Vieux-Lille chez LÜM : 25 €, le week-end de 11h à 15h30. En terrasse, en intérieur ou dans une cave voûtée naturellement climatisée.',
    retour: 'Retour',
    accroche: 'Compose ton brunch à ton goût',
    illustration: 'Œufs cocotte',
    prix: '25 €',
    formule: 'Un salé, un sucré, une boisson chaude et une boisson froide.',
    horaires: ['Uniquement le week-end,', '11h – 15h30'],
    reserver: 'Réserver',
    menu: 'Le menu',
    menuIntro: 'Une option dans chaque bloc.',
    blocs: [
      {
        titre: 'Ta douceur salée',
        resume: '2 recettes',
        texte: 'Des œufs cocotte accompagnés de tartines, en deux recettes au choix :',
        options: [
          'Chèvre, miel, pommes et noix',
          'Cream cheese, moutarde, effiloché de canard et oignons caramélisés',
        ],
        recettes: true,
      },
      {
        titre: 'Ta douceur sucrée',
        resume: '4 au choix',
        texte: 'Un dessert au choix :',
        options: ['Cookie', 'Cinnamon roll', 'Granola bowl', 'Flan'],
      },
      {
        titre: 'Ta boisson chaude',
        resume: '6 au choix',
        texte: 'Une boisson au choix :',
        options: [
          'Espresso',
          'Allongé',
          'Double espresso',
          'Cappuccino',
          'Thé / infusion',
          'Chocolat chaud',
        ],
      },
      {
        titre: 'Ta boisson froide',
        resume: '3 au choix',
        texte: 'Une boisson au choix :',
        options: ['Citron pressé', 'Jus de pomme', 'Orange pressée'],
      },
    ],
    lieux: 'Bruncher dans le Vieux-Lille',
    lieuxIntro:
      'Chez LÜM, au 94 rue Saint-André, le brunch se savoure en terrasse, en intérieur ou dans notre cave voûtée naturellement climatisée.',
    espaces: [
      { titre: 'En terrasse', texte: 'Pour bruncher dehors.', trace: TRACES.terrasse },
      { titre: 'En intérieur', texte: 'Dans la salle du coffee shop.', trace: TRACES.interieur },
      { titre: 'En cave voûtée', texte: 'Naturellement climatisée.', trace: TRACES.cave },
    ],
    cadeau: {
      titre: 'Offrir le brunch',
      texte:
        'Une carte cadeau pour un ou plusieurs brunchs, avec ton petit mot dessus. Envoyée par e-mail en PDF, à imprimer ou à transférer, et valable un an.',
      bouton: 'Offrir le brunch',
      precision: '',
    },
    note: 'Prix en euros, taxes comprises.',
  },
  en: {
    titre: 'Brunch in Vieux-Lille — LÜM, terrace & vaulted cellar',
    description:
      'Brunch in Vieux-Lille (Old Lille) at LÜM: €25, weekends from 11am to 3:30pm. On the terrace, indoors or in our naturally cool vaulted cellar.',
    retour: 'Back',
    accroche: 'Build your brunch, your way',
    illustration: 'Baked eggs',
    prix: '€25',
    formule: 'Something savoury, something sweet, a hot drink and a cold drink.',
    horaires: ['Weekends only,', '11am – 3:30pm'],
    reserver: 'Book a table',
    menu: 'The menu',
    menuIntro: 'Pick one option from each part.',
    blocs: [
      {
        titre: 'Your savoury treat',
        resume: '2 recipes',
        texte: 'Baked eggs (œufs cocotte) served with tartines, in two recipes:',
        options: [
          'Goat cheese, honey, apple and walnuts',
          'Cream cheese, mustard, pulled duck and caramelised onions',
        ],
        recettes: true,
      },
      {
        titre: 'Your sweet treat',
        resume: 'pick 1 of 4',
        texte: 'A dessert of your choice:',
        options: ['Cookie', 'Cinnamon roll', 'Granola bowl', 'Flan'],
      },
      {
        titre: 'Your hot drink',
        resume: 'pick 1 of 6',
        texte: 'A drink of your choice:',
        options: [
          'Espresso',
          'Americano',
          'Double espresso',
          'Cappuccino',
          'Tea / herbal tea',
          'Hot chocolate',
        ],
      },
      {
        titre: 'Your cold drink',
        resume: 'pick 1 of 3',
        texte: 'A drink of your choice:',
        options: ['Fresh lemon juice', 'Apple juice', 'Fresh orange juice'],
      },
    ],
    lieux: 'Brunch in Vieux-Lille',
    lieuxIntro:
      'At LÜM, 94 rue Saint-André, enjoy your brunch on the terrace, indoors or in our naturally cool vaulted cellar.',
    espaces: [
      { titre: 'On the terrace', texte: 'Brunch outdoors.', trace: TRACES.terrasse },
      { titre: 'Indoors', texte: 'Inside the coffee shop.', trace: TRACES.interieur },
      { titre: 'In the vaulted cellar', texte: 'Naturally cool.', trace: TRACES.cave },
    ],
    cadeau: {
      titre: 'Give brunch as a gift',
      texte:
        'A gift card for one or more brunches, with your own message on it. Sent by e-mail as a PDF to print or forward, and valid for one year.',
      bouton: 'Give a brunch',
      precision: 'Order form in French',
    },
    note: 'Prices in euros, taxes included.',
  },
}[langue];
---

<BaseLayout title={textes.titre} description={textes.description} langue={langue} chemins={adresses}>
  <div class="page">
    <header class="entete">
      <a class="logo" href={accueil}>
        LÜM
        <small>Vieux-Lille</small>
      </a>
      <div class="entete__droite">
        <ChoixLangue langue={langue} chemins={adresses} />
        <a class="retour" href={accueil}>
          <span class="arrow">←</span> {textes.retour}
        </a>
      </div>
    </header>

    <section class="panel">
      <!-- Le titre porte la requête visée : « brunch Vieux-Lille ». -->
      <div class="chip">
        <h1>Brunch <span class="chip__lieu">Vieux-Lille</span></h1>
      </div>

      <p class="script">{textes.accroche}</p>

      <!-- Un œuf cocotte au trait : ramequin cannelé, jaune et ciboulette, un
           peu de vapeur. Repris tel quel dans le PDF de la carte cadeau
           (api/_lib/pdf.ts) : à modifier ensemble. -->
      <svg class="illustration" viewBox="0 0 120 84" role="img" aria-label={textes.illustration}>
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M48 16c-3-3.5 3-6.5 0-10 M60 14c-3-3.5 3-6.5 0-10 M72 16c-3-3.5 3-6.5 0-10" />
          <ellipse cx="60" cy="34" rx="46" ry="13" />
          <ellipse cx="60" cy="34" rx="37" ry="8.5" />
          <ellipse cx="62" cy="33.5" rx="9" ry="4.5" />
          <path d="M37 33l3-1.2 M80 36.5l2.8.8 M44 37.5l2.6.6 M78 29.5l2.4-.6" />
          <path d="M14 34v6c0 8 3 20 8 26 6 7 21 11 38 11s32-4 38-11c5-6 8-18 8-26v-6" />
          <path d="M30 50l1.5 16 M45 52l.8 19 M60 53v20 M75 52l-.8 19 M90 50l-1.5 16" />
        </g>
      </svg>

      <p class="prix">{textes.prix}</p>

      <p class="lede">{textes.formule}</p>

      <p class="adresse">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </g>
        </svg>
        <span>94 rue Saint-André,</span>
        <span>Vieux-Lille</span>
      </p>

      <p class="horaires">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </g>
        </svg>
        {textes.horaires.map((morceau) => <span>{morceau}</span>)}
      </p>

      <a class="lum-pill-btn" href={RESERVATION} target="_blank" rel="noopener noreferrer">
        {textes.reserver} <span class="arrow">→</span>
      </a>
    </section>

    <!-- Le menu en accordéon : un pli par choix à faire. Le contenu des plis
         fermés reste dans la page (lu par les moteurs et les lecteurs
         d'écran). « name » n'en laisse qu'un ouvert à la fois. -->
    <section class="bloc menu" aria-labelledby="menu-titre">
      <div class="chip">
        <h2 id="menu-titre">{textes.menu}</h2>
      </div>

      <p class="menu__intro">{textes.menuIntro}</p>

      <div class="accordeon">
        {
          textes.blocs.map((bloc, i) => (
            <details class="pli" name="menu-brunch" open={i === 0}>
              <summary>
                <span class="pli__titre">{bloc.titre}</span>
                <span class="pli__resume">{bloc.resume}</span>
                <span class="pli__signe" aria-hidden="true" />
              </summary>
              <div class="pli__contenu">
                <p class="pli__texte">{bloc.texte}</p>
                <ul class:list={['options', { 'options--recettes': bloc.recettes }]}>
                  {bloc.options.map((option) => (
                    <li class="option">{option}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="bloc cadeau">
      <div class="chip">
        <h2>{textes.cadeau.titre}</h2>
      </div>

      <svg class="cadeau__icone" viewBox="0 0 48 48" aria-hidden="true">
        <path
          d={CADEAU}
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <p class="cadeau__texte">{textes.cadeau.texte}</p>

      <a class="lum-pill-btn" href={CARTE_CADEAU} hreflang={langue === 'fr' ? undefined : 'fr'}>
        {textes.cadeau.bouton} <span class="arrow">→</span>
      </a>
      {textes.cadeau.precision && <p class="cadeau__precision">{textes.cadeau.precision}</p>}
    </section>

    <section class="bloc lieux">
      <div class="chip">
        <h2>{textes.lieux}</h2>
      </div>

      <p class="lieux__intro">{textes.lieuxIntro}</p>

      <ul class="espaces">
        {
          textes.espaces.map((espace) => (
            <li class="espace">
              <svg viewBox="0 0 48 48" aria-hidden="true">
                <path
                  d={espace.trace}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <h3>{espace.titre}</h3>
              <p>{espace.texte}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="note">{textes.note}</p>
  </div>
</BaseLayout>

<style>
  /* Même largeur de contenu que les panneaux de l'accueil. */
  .page {
    max-width: calc(820px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  /* --- En-tête, sur la terre cuite --- */
  .entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--cream);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .logo small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .entete__droite {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .retour {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .retour:hover,
  .retour:focus-visible {
    border-bottom-color: var(--cream);
  }

  .retour .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .retour:hover .arrow {
    transform: translateX(-3px);
  }

  /* --- Panneau d'ouverture : la formule, son prix et ses horaires --- */
  .panel {
    position: relative;
    margin-top: 44px;
    padding: 100px 40px 56px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche du titre chevauche le bord du bloc, comme sur l'affiche */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 14px 34px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
  }

  /* « Vieux-Lille » sous « Brunch », comme sous le logo LÜM. L'espace de
     la source reste dans le texte du titre : « Brunch Vieux-Lille ». */
  .chip__lieu {
    display: block;
    margin: 6px -0.3em 0 0; /* compense l'interlettrage après le dernier « e » */
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(0.8rem, 2.2vw, 1rem);
    line-height: 1;
    letter-spacing: 0.3em;
  }

  .script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .illustration {
    display: block;
    width: 140px;
    margin: 26px auto 14px;
    color: var(--terracotta);
  }

  .prix {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .lede {
    max-width: 46ch;
    margin: 6px auto 20px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  /* Sur mobile, la fin de ligne passe dessous d'un bloc, sans couper le
     « week-end » ni détacher l'icône du texte. */
  .adresse,
  .horaires {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.3em; /* entre les deux morceaux, l'équivalent d'une espace */
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .adresse {
    margin-bottom: 6px;
  }

  .horaires {
    margin-bottom: 30px;
    color: var(--brown);
  }

  .adresse svg,
  .horaires svg {
    width: 19px;
    height: 19px;
    margin-right: 3px;
    flex: none;
  }

  /* Bouton plein : c'est l'action principale de la page. */
  .panel .lum-pill-btn {
    background: var(--terracotta);
    color: var(--cream);
  }

  .panel .lum-pill-btn:hover,
  .panel .lum-pill-btn:focus-visible {
    background: var(--terracotta-dark);
    border-color: var(--terracotta-dark);
  }

  /* --- Blocs crème à cartouche : menu, carte cadeau, espaces --- */
  .bloc {
    position: relative;
    margin-top: 24px;
    padding: 62px 34px 40px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  .bloc .chip {
    padding: 11px 28px;
  }

  .bloc h2 {
    font-size: clamp(1.3rem, 3.4vw, 1.75rem);
    white-space: normal;
    text-wrap: balance;
  }

  /* --- Le menu, en accordéon --- */
  .menu {
    padding-bottom: 26px;
    animation-delay: 0.1s;
  }

  .menu__intro {
    margin-bottom: 18px;
    font-family: var(--font-script);
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--brown);
  }

  .accordeon {
    /* Permet d'animer la hauteur jusqu'à « auto » là où c'est pris en charge. */
    interpolate-size: allow-keywords;
    text-align: left;
  }

  .pli + .pli {
    border-top: 2px solid rgba(196, 113, 74, 0.35);
  }

  .pli summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }

  .pli summary::-webkit-details-marker {
    display: none;
  }

  .pli summary:focus-visible {
    outline: 3px solid var(--terracotta-light);
    outline-offset: 2px;
  }

  .pli__titre {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .pli__resume {
    font-family: var(--font-script);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--brown);
    white-space: nowrap;
  }

  /* Un « + » cerclé qui devient « − » à l'ouverture. */
  .pli__signe {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border: 2.5px solid var(--terracotta-light);
    border-radius: 50%;
    transition: background 0.2s, border-color 0.2s;
  }

  .pli__signe::before,
  .pli__signe::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 2.5px;
    margin: -1.25px 0 0 -6.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s ease;
  }

  .pli__signe::after {
    transform: rotate(90deg);
  }

  .pli[open] .pli__signe::after {
    transform: rotate(0deg);
  }

  .pli summary:hover .pli__signe,
  .pli[open] .pli__signe {
    background: var(--terracotta);
    border-color: var(--terracotta);
    color: var(--cream);
  }

  /* Ouverture en douceur (navigateurs récents ; ailleurs, sans animation). */
  .pli::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.35s ease,
      content-visibility 0.35s allow-discrete;
  }

  .pli[open]::details-content {
    block-size: auto;
  }

  .pli__contenu {
    padding: 0 4px 22px;
  }

  .pli__texte {
    margin-bottom: 14px;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--brown);
  }

  /* Les options en pastilles : on en prend une. */
  .options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .option {
    padding: 7px 18px;
    border: 2.5px solid var(--terracotta-light);
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.35;
  }

  /* Les recettes, plus longues, passent sur plusieurs lignes : une par ligne,
     en cartouche plutôt qu'en pilule. */
  .options--recettes {
    flex-direction: column;
  }

  .options--recettes .option {
    border-radius: var(--radius);
    padding: 12px 18px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pli::details-content,
    .pli__signe,
    .pli__signe::before,
    .pli__signe::after {
      transition: none;
    }
  }

  /* --- Offrir le brunch : la carte cadeau --- */
  .cadeau {
    animation-delay: 0.2s;
  }

  .cadeau__icone {
    display: block;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
  }

  .cadeau__texte {
    max-width: 50ch;
    margin: 0 auto 24px;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .cadeau__precision {
    margin-top: 10px;
    font-family: var(--font-script);
    font-size: 1.2rem;
    line-height: 1.2;

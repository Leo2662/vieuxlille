---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChoixLangue from './ChoixLangue.astro';
import { chemins, type Langue } from '../i18n';
import { QUANTITE_MAX } from '../../api/_lib/config.ts';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;

const RESERVATION = 'https://lumvieuxlille-hash.github.io/lum-vieuxlille/';

const adresses = chemins('brunch/');
const accueil = chemins('')[langue];

// Pictogrammes au trait des trois espaces, communs aux deux langues.
const TRACES = {
  // Parasol et sa table
  terrasse:
    'M6 22C6 12.6 14 6 24 6s18 6.6 18 16 M6 22c3-2.2 6-2.2 9 0s6 2.2 9 0 6-2.2 9 0 6 2.2 9 0 M24 22v20 M24 6V3 M14 32h20 M17 42h14',
  // Suspension au-dessus d'une table
  interieur: 'M24 3v8 M15 19l4-8h10l4 8z M10 30h28 M14 30v12 M34 30v12',
  // Voûte de pierre, ses claveaux et le sol
  cave: 'M7 43V24a17 17 0 0 1 34 0v19 M15 43V24a9 9 0 0 1 18 0v19 M24 7v8 M12 12l5.7 5.7 M36 12l-5.7 5.7 M3 43h42',
};

// Paquet cadeau et son nœud, pour l'encart carte cadeau.
const CADEAU =
  'M9 21h30v21H9z M6 14h36v7H6z M24 14v28 M24 14c-2.5-6.5-11-9-11-3.5 0 3.5 6 3.5 11 3.5 M24 14c2.5-6.5 11-9 11-3.5 0 3.5-6 3.5-11 3.5';

// La commande d'une carte cadeau n'existe qu'en français (comme l'afterwork).
const CARTE_CADEAU = '/brunch/carte-cadeau/';

// Une formule à prix unique : on choisit une option dans chaque bloc.
// Prix, horaires, options et espaces sont redits dans public/llms.txt : à
// modifier ensemble, dans les deux langues. Les espaces insécables ( )
// évitent qu'un mot reste seul en fin de ligne.
const textes = {
  fr: {
    titre: 'Brunch Vieux-Lille — LÜM, terrasse et cave voûtée',
    description:
      'Brunch dans le Vieux-Lille chez LÜM : 25 €, le week-end de 11h à 15h30. En terrasse, en intérieur ou dans une cave voûtée naturellement climatisée.',
    retour: 'Retour',
    accroche: 'Compose ton brunch à ton goût',
    illustration: 'Œufs cocotte',
    prix: '25 €',
    formule: 'Un salé, un sucré, une boisson chaude et une boisson froide.',
    horaires: ['Uniquement le week-end,', '11h – 15h30'],
    reserver: 'Réserver',
    menu: 'Le menu',
    menuIntro: 'Une option dans chaque bloc.',
    blocs: [
      {
        titre: 'Ta douceur salée',
        resume: '2 recettes',
        texte: 'Des œufs cocotte accompagnés de tartines, en deux recettes au choix :',
        options: [
          'Chèvre, miel, pommes et noix',
          'Cream cheese, moutarde, effiloché de canard et oignons caramélisés',
        ],
        recettes: true,
      },
      {
        titre: 'Ta douceur sucrée',
        resume: '4 au choix',
        texte: 'Un dessert au choix :',
        options: ['Cookie', 'Cinnamon roll', 'Granola bowl', 'Flan'],
      },
      {
        titre: 'Ta boisson chaude',
        resume: '6 au choix',
        texte: 'Une boisson au choix :',
        options: [
          'Espresso',
          'Allongé',
          'Double espresso',
          'Cappuccino',
          'Thé / infusion',
          'Chocolat chaud',
        ],
      },
      {
        titre: 'Ta boisson froide',
        resume: '3 au choix',
        texte: 'Une boisson au choix :',
        options: ['Citron pressé', 'Jus de pomme', 'Orange pressée'],
      },
    ],
    lieux: 'Bruncher dans le Vieux-Lille',
    lieuxIntro:
      'Chez LÜM, au 94 rue Saint-André, le brunch se savoure en terrasse, en intérieur ou dans notre cave voûtée naturellement climatisée.',
    espaces: [
      { titre: 'En terrasse', texte: 'Pour bruncher dehors, rue Saint-André, au cœur du Vieux-Lille.', trace: TRACES.terrasse },
      { titre: 'En intérieur', texte: 'Dans la salle du coffee shop, à deux pas du comptoir.', trace: TRACES.interieur },
      {
        titre: 'En cave voûtée',
        texte: 'Notre cave voûtée est naturellement climatisée : on y brunche au frais, même en plein été.',
        trace: TRACES.cave,
      },
    ],
    // Les intitulés des occasions portent les recherches visées
    // (« offrir un brunch pour Noël », « carte cadeau brunch »…).
    cadeau: {
      titre: 'Offrir un brunch',
      bouton: 'Offrir la carte',
      precision: '',
      occasionsTitre: 'Une carte cadeau brunch pour chaque occasion',
      occasionsResume: 'idées',
      occasions: [
        {
          titre: 'Offrir un brunch pour Noël',
          texte:
            "Une idée cadeau de Noël qui se savoure : la carte arrive tout de suite par e-mail, en PDF, même commandée le 24 au soir. À glisser sous le sapin, imprimée ou transférée, pour un brunch dans le Vieux-Lille quand on veut dans l'année.",
        },
        {
          titre: 'Offrir un brunch pour un anniversaire',
          texte: `Un cadeau d'anniversaire à partager : offre un brunch pour deux, ou pour toute la bande (jusqu'à ${QUANTITE_MAX} sur une même carte), avec ton petit mot imprimé dessus.`,
        },
        {
          titre: 'Offrir un brunch pour la Saint-Valentin',
          texte:
            'Deux brunchs, un mot doux sur la carte, et un week-end à deux au cœur du Vieux-Lille : en terrasse, en salle ou dans notre cave voûtée.',
        },
        {
          titre: 'Offrir un brunch pour la fête des mères ou des pères',
          texte: "Un week-end en famille autour d'une bonne table : choisis le nombre de brunchs, chacun compose le sien.",
        },
        {
          titre: 'Offrir un brunch pour dire merci',
          texte:
            "Pour une collègue qui s'en va, un voisin serviable ou une nounou adorée : un cadeau simple, qui fait toujours plaisir.",
        },
      ],
      faqTitre: 'Questions fréquentes',
      faqResume: 'questions',
      faq: [
        {
          question: "Comment j'offre la carte cadeau ?",
          reponse:
            "Clique sur « Offrir la carte », choisis le nombre de brunchs, ajoute le prénom de la personne et ton petit mot, puis paie en ligne par carte bancaire, en toute sécurité avec Square. Tu reçois aussitôt la carte cadeau en PDF par e-mail : imprime-la ou transfère-la à la personne.",
        },
        {
          question: 'Quelle est la date de validité ?',
          reponse: "La carte est valable un an à partir de l'achat. La date limite est écrite dessus.",
        },
        {
          question: 'Comment utiliser la carte ?',
          reponse:
            'Viens le week-end, entre 11h et 15h30, au 94 rue Saint-André, et montre la carte au comptoir, imprimée ou sur ton téléphone. Pense à réserver : 06 42 99 62 42.',
        },
        {
          question: 'Combien coûte une carte cadeau brunch ?',
          reponse: `25 € par brunch, de 1 à ${QUANTITE_MAX} brunchs sur une même carte. Chaque brunch comprend une douceur salée, une douceur sucrée, une boisson chaude et une boisson froide.`,
        },
        {
          question: "Je n'ai pas reçu l'e-mail, que faire ?",
          reponse:
            'Regarde dans tes courriers indésirables. Toujours rien ? Appelle-nous au 06 42 99 62 42 et on te la renvoie.',
        },
      ],
    },
    note: 'Prix en euros, taxes comprises.',
  },
  en: {
    titre: 'Brunch in Vieux-Lille — LÜM, terrace & vaulted cellar',
    description:
      'Brunch in Vieux-Lille (Old Lille) at LÜM: €25, weekends from 11am to 3:30pm. On the terrace, indoors or in our naturally cool vaulted cellar.',
    retour: 'Back',
    accroche: 'Build your brunch, your way',
    illustration: 'Baked eggs',
    prix: '€25',
    formule: 'Something savoury, something sweet, a hot drink and a cold drink.',
    horaires: ['Weekends only,', '11am – 3:30pm'],
    reserver: 'Book a table',
    menu: 'The menu',
    menuIntro: 'Pick one option from each part.',
    blocs: [
      {
        titre: 'Your savoury treat',
        resume: '2 recipes',
        texte: 'Baked eggs (œufs cocotte) served with tartines, in two recipes:',
        options: [
          'Goat cheese, honey, apple and walnuts',
          'Cream cheese, mustard, pulled duck and caramelised onions',
        ],
        recettes: true,
      },
      {
        titre: 'Your sweet treat',
        resume: 'pick 1 of 4',
        texte: 'A dessert of your choice:',
        options: ['Cookie', 'Cinnamon roll', 'Granola bowl', 'Flan'],
      },
      {
        titre: 'Your hot drink',
        resume: 'pick 1 of 6',
        texte: 'A drink of your choice:',
        options: [
          'Espresso',
          'Americano',
          'Double espresso',
          'Cappuccino',
          'Tea / herbal tea',
          'Hot chocolate',
        ],
      },
      {
        titre: 'Your cold drink',
        resume: 'pick 1 of 3',
        texte: 'A drink of your choice:',
        options: ['Fresh lemon juice', 'Apple juice', 'Fresh orange juice'],
      },
    ],
    lieux: 'Brunch in Vieux-Lille',
    lieuxIntro:
      'At LÜM, 94 rue Saint-André, enjoy your brunch on the terrace, indoors or in our naturally cool vaulted cellar.',
    espaces: [
      { titre: 'On the terrace', texte: 'Brunch outdoors, on rue Saint-André, in the heart of Vieux-Lille.', trace: TRACES.terrasse },
      { titre: 'Indoors', texte: "In the coffee shop's dining room, right by the counter.", trace: TRACES.interieur },
      {
        titre: 'In the vaulted cellar',
        texte: 'Our vaulted cellar is naturally cool: the perfect spot to brunch, even in the height of summer.',
        trace: TRACES.cave,
      },
    ],
    cadeau: {
      titre: 'Give brunch as a gift',
      bouton: 'Give the gift card',
      precision: 'Order form in French',
      occasionsTitre: 'A brunch gift card for every occasion',
      occasionsResume: 'ideas',
      occasions: [
        {
          titre: 'Give brunch for Christmas',
          texte:
            'A Christmas gift you can taste: the card arrives instantly by e-mail as a PDF, even if you order on Christmas Eve. Print it or forward it, for a brunch in Vieux-Lille any time within the year.',
        },
        {
          titre: 'Give brunch for a birthday',
          texte: `A birthday gift to share: give brunch for two, or for the whole gang (up to ${QUANTITE_MAX} on one card), with your own message printed on it.`,
        },
        {
          titre: "Give brunch for Valentine's Day",
          texte: 'Two brunches, a sweet note on the card, and a weekend for two in the heart of Vieux-Lille.',
        },
        {
          titre: "Give brunch for Mother's or Father's Day",
          texte: 'A family weekend around a good table: choose how many brunches, and everyone builds their own.',
        },
        {
          titre: 'Give brunch to say thank you',
          texte:
            "For a colleague who's leaving, a helpful neighbour or a much-loved nanny: a simple gift that always goes down well.",
        },
      ],
      faqTitre: 'Frequently asked questions',
      faqResume: 'questions',
      faq: [
        {
          question: 'How do I give the gift card?',
          reponse:
            "Click “Give the gift card”, choose the number of brunches, add the recipient's name and your message, then pay online by card, securely with Square. The gift card arrives straight away by e-mail as a PDF: print it or forward it. The order form is in French.",
        },
        {
          question: 'How long is it valid?',
          reponse: 'One year from purchase. The expiry date is printed on the card.',
        },
        {
          question: 'How do I use it?',
          reponse:
            'Come at the weekend, between 11am and 3:30pm, to 94 rue Saint-André, and show the card at the counter, printed or on your phone. Booking recommended: +33 6 42 99 62 42.',
        },
        {
          question: 'How much does a brunch gift card cost?',
          reponse: `€25 per brunch, from 1 to ${QUANTITE_MAX} brunches on one card. Each brunch includes a savoury treat, a sweet treat, a hot drink and a cold drink.`,
        },
        {
          question: "I didn't get the e-mail, what now?",
          reponse: "Check your spam folder. Still nothing? Call us on +33 6 42 99 62 42 and we'll resend it.",
        },
      ],
    },
    note: 'Prices in euros, taxes included.',
  },
}[langue];

// La FAQ de la carte cadeau, redite pour les moteurs de recherche.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: textes.cadeau.faq.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.reponse },
  })),
};
---

<BaseLayout title={textes.titre} description={textes.description} langue={langue} chemins={adresses}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <div class="page">
    <header class="entete">
      <a class="logo" href={accueil}>
        LÜM
        <small>Vieux-Lille</small>
      </a>
      <div class="entete__droite">
        <ChoixLangue langue={langue} chemins={adresses} />
        <a class="retour" href={accueil}>
          <span class="arrow">←</span> {textes.retour}
        </a>
      </div>
    </header>

    <section class="panel">
      <!-- Le titre porte la requête visée : « brunch Vieux-Lille ». -->
      <div class="chip">
        <h1>Brunch <span class="chip__lieu">Vieux-Lille</span></h1>
      </div>

      <p class="script">{textes.accroche}</p>

      <!-- Un œuf cocotte au trait : ramequin cannelé, jaune et ciboulette, un
           peu de vapeur. Repris tel quel dans le PDF de la carte cadeau
           (api/_lib/pdf.ts) : à modifier ensemble. -->
      <svg class="illustration" viewBox="0 0 120 84" role="img" aria-label={textes.illustration}>
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M48 16c-3-3.5 3-6.5 0-10 M60 14c-3-3.5 3-6.5 0-10 M72 16c-3-3.5 3-6.5 0-10" />
          <ellipse cx="60" cy="34" rx="46" ry="13" />
          <ellipse cx="60" cy="34" rx="37" ry="8.5" />
          <ellipse cx="62" cy="33.5" rx="9" ry="4.5" />
          <path d="M37 33l3-1.2 M80 36.5l2.8.8 M44 37.5l2.6.6 M78 29.5l2.4-.6" />
          <path d="M14 34v6c0 8 3 20 8 26 6 7 21 11 38 11s32-4 38-11c5-6 8-18 8-26v-6" />
          <path d="M30 50l1.5 16 M45 52l.8 19 M60 53v20 M75 52l-.8 19 M90 50l-1.5 16" />
        </g>
      </svg>

      <p class="prix">{textes.prix}</p>

      <p class="lede">{textes.formule}</p>

      <p class="adresse">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </g>
        </svg>
        <span>94 rue Saint-André,</span>
        <span>Vieux-Lille</span>
      </p>

      <p class="horaires">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </g>
        </svg>
        {textes.horaires.map((morceau) => <span>{morceau}</span>)}
      </p>

      <a
        class="lum-pill-btn"
        href={RESERVATION}
        target="_blank"
        rel="noopener noreferrer"
        data-suivi="clic_reservation"
        data-suivi-emplacement="brunch"
      >
        {textes.reserver} <span class="arrow">→</span>
      </a>
    </section>

    <!-- Le menu en accordéon : un pli par choix à faire. Le contenu des plis
         fermés reste dans la page (lu par les moteurs et les lecteurs
         d'écran). « name » n'en laisse qu'un ouvert à la fois. -->
    <section class="bloc menu" aria-labelledby="menu-titre">
      <div class="chip">
        <h2 id="menu-titre">{textes.menu}</h2>
      </div>

      <p class="menu__intro">{textes.menuIntro}</p>

      <div class="accordeon">
        {
          textes.blocs.map((bloc, i) => (
            <details class="pli" name="menu-brunch" open={i === 0}>
              <summary>
                <span class="pli__titre">{bloc.titre}</span>
                <span class="pli__resume">{bloc.resume}</span>
                <span class="pli__signe" aria-hidden="true" />
              </summary>
              <div class="pli__contenu">
                <p class="pli__texte">{bloc.texte}</p>
                <ul class:list={['options', { 'options--recettes': bloc.recettes }]}>
                  {bloc.options.map((option) => (
                    <li class="option">{option}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section class="bloc cadeau">
      <div class="chip">
        <h2>{textes.cadeau.titre}</h2>
      </div>

      <svg class="cadeau__icone" viewBox="0 0 48 48" aria-hidden="true">
        <path
          d={CADEAU}
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <a
        class="lum-pill-btn"
        href={CARTE_CADEAU}
        hreflang={langue === 'fr' ? undefined : 'fr'}
        data-suivi="select_item"
        data-suivi-item-list-name="Page brunch"
        data-suivi-article="carte-cadeau"
      >
        {textes.cadeau.bouton} <span class="arrow">→</span>
      </a>
      {textes.cadeau.precision && <p class="cadeau__precision">{textes.cadeau.precision}</p>}

      <!-- Les occasions sont repliées dans un pli de plus : la section reste
           courte, et leur texte reste dans la page pour les moteurs. -->
      <div class="accordeon groupe-plie">
        <details class="pli">
          <summary>
            <span class="pli__titre">{textes.cadeau.occasionsTitre}</span>
            <span class="pli__resume">
              {textes.cadeau.occasions.length} {textes.cadeau.occasionsResume}
            </span>
            <span class="pli__signe" aria-hidden="true" />
          </summary>
          <div class="pli__contenu">
            <div class="accordeon accordeon--imbrique">
              {
                textes.cadeau.occasions.map((occasion) => (
                  <details class="pli" name="occasions">
                    <summary>
                      <span class="pli__titre pli__titre--court">{occasion.titre}</span>
                      <span class="pli__signe" aria-hidden="true" />
                    </summary>
                    <div class="pli__contenu">
                      <p class="pli__texte">{occasion.texte}</p>
                    </div>
                  </details>
                ))
              }
            </div>
          </div>
        </details>
      </div>

      <div class="accordeon groupe-plie groupe-plie--suite">
        <details class="pli">
          <summary>
            <span class="pli__titre">{textes.cadeau.faqTitre}</span>
            <span class="pli__resume">
              {textes.cadeau.faq.length} {textes.cadeau.faqResume}
            </span>
            <span class="pli__signe" aria-hidden="true" />
          </summary>
          <div class="pli__contenu">
            <div class="accordeon accordeon--imbrique">
              {
                textes.cadeau.faq.map((q) => (
                  <details class="pli" name="faq">
                    <summary>
                      <span class="pli__titre pli__titre--court">{q.question}</span>
                      <span class="pli__signe" aria-hidden="true" />
                    </summary>
                    <div class="pli__contenu">
                      <p class="pli__texte">{q.reponse}</p>
                    </div>
                  </details>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="bloc lieux">
      <div class="chip">
        <h2>{textes.lieux}</h2>
      </div>

      <p class="lieux__intro">{textes.lieuxIntro}</p>

      <div class="accordeon">
        {
          textes.espaces.map((espace) => (
            <details class="pli" name="espaces">
              <summary>
                <svg class="pli__icone" viewBox="0 0 48 48" aria-hidden="true">
                  <path
                    d={espace.trace}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="pli__titre">{espace.titre}</span>
                <span class="pli__signe" aria-hidden="true" />
              </summary>
              <div class="pli__contenu">
                <p class="pli__texte">{espace.texte}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <p class="note">{textes.note}</p>
  </div>
</BaseLayout>

<style>
  /* Même largeur de contenu que les panneaux de l'accueil. */
  .page {
    max-width: calc(820px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  /* --- En-tête, sur la terre cuite --- */
  .entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--cream);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .logo small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .entete__droite {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .retour {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .retour:hover,
  .retour:focus-visible {
    border-bottom-color: var(--cream);
  }

  .retour .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .retour:hover .arrow {
    transform: translateX(-3px);
  }

  /* --- Panneau d'ouverture : la formule, son prix et ses horaires --- */
  .panel {
    position: relative;
    margin-top: 44px;
    padding: 100px 40px 56px;
    border-radius: var(--radius-lg);

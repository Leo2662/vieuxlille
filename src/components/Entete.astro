---
// En-tête des pages intérieures, sur la terre cuite : logo et retour.
// Le retour mène à l'accueil, sauf si la page en indique un autre.
// Sur une page traduite, `langue` et `chemins` ajoutent le choix de langue.
import ChoixLangue from './ChoixLangue.astro';
import type { Langue } from '../i18n';

interface Props {
  retour?: string;
  langue?: Langue;
  chemins?: Record<Langue, string>;
}

const { langue = 'fr', chemins } = Astro.props;
const accueil = langue === 'fr' ? '/' : '/en/';
const retour = Astro.props.retour ?? accueil;
---

<header class="entete">
  <a class="logo" href={accueil}>
    LÜM
    <small>Vieux-Lille</small>
  </a>
  <div class="entete__droite">
    {chemins && <ChoixLangue langue={langue} chemins={chemins} />}
    <a class="retour" href={retour}>
      <span class="arrow">←</span> {langue === 'fr' ? 'Retour' : 'Back'}
    </a>
  </div>
</header>

<style>
  .entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--cream);
  }

  .entete__droite {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .logo small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .retour {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .retour:hover,
  .retour:focus-visible {
    border-bottom-color: var(--cream);
  }

  .retour .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .retour:hover .arrow {
    transform: translateX(-3px);
  }
</style>

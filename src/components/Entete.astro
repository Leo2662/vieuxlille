---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="entete">
  <a class="logo" href={`${base}/`}>
    LÜM
    <small>Vieux-Lille</small>
  </a>
  <a class="retour" href={`${base}/`}>
    <span class="arrow">←</span> Retour
  </a>
</header>

<style>
  .entete {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 4px 0 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--cream);
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  .logo small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .retour {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .retour:hover,
  .retour:focus-visible {
    border-bottom-color: var(--cream);
  }

  .retour .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .retour:hover .arrow {
    transform: translateX(-3px);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Entete from '../components/Entete.astro';
import { rubriques } from '../data/carte';
---

<BaseLayout
  title="La carte — LÜM Vieux-Lille"
  description="L'offre des 5 & 6 septembre chez LÜM Vieux-Lille : bières artisanales, vin, burrata et mini saucissons."
>
  <div class="page">
    <Entete />

    <h1 class="titre-page">La carte</h1>

    {
      rubriques.map((rubrique) => (
        <section class="bloc">
          <div class="chip">
            <h2>{rubrique.titre}</h2>
          </div>

          <ul class={rubrique.articles.length > 8 ? 'articles articles--deux' : 'articles'}>
            {rubrique.articles.map((article) => (
              <li class="article">
                <div class="article__ligne">
                  <span class="article__nom">{article.nom}</span>
                  <span class="article__filet" aria-hidden="true" />
                  <span class="article__prix">{article.prix}</span>
                </div>
                {article.description && <p class="article__desc">{article.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="note">Prix en euros, taxes comprises.</p>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 46px;
  }

  .titre-page {
    margin: 18px 0 0;
    text-align: center;
    font-size: clamp(2.6rem, 9vw, 5rem);
    color: var(--cream);
  }

  /* --- Bloc crème, avec cartouche de titre à cheval sur le bord --- */
  .bloc {
    position: relative;
    padding: 62px 34px 38px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
  }

  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 11px 28px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .chip h2 {
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
  }

  /* --- Articles --- */
  .articles {
    list-style: none;
    /* Sur une colonne, on resserre : sinon les pointillés s'étirent */
    max-width: 720px;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 20px 46px;
  }

  .articles--deux {
    max-width: none;
    grid-template-columns: repeat(2, 1fr);
  }

  .article__ligne {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .article__nom {
    font-weight: 800;
    font-size: 1.02rem;
  }

  .article__filet {
    flex: 1;
    min-width: 18px;
    border-bottom: 2px dotted var(--terracotta-light);
    transform: translateY(-5px);
  }

  .article__prix {
    font-weight: 800;
    font-size: 1.02rem;
    white-space: nowrap;
  }

  .article__desc {
    margin-top: 2px;
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--brown);
  }

  .note {
    text-align: center;
    color: var(--cream);
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .bloc {
      padding: 56px 20px 32px;
    }

    .articles--deux {
      grid-template-columns: 1fr;
    }
  }
</style>

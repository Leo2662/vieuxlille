---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entete from '../../components/Entete.astro';
import { billets, dateLisible, dateIso, minutesDeLecture, type Billet } from '../../lib/blog';

export async function getStaticPaths() {
  const articles = await billets();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Billet;
}

const { article } = Astro.props;
const { titre, description, date } = article.data;
const { Content } = await render(article);

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://lumvieuxlille.fr';

// Fiche article pour les moteurs de recherche. L'auteur et l'éditeur sont
// le café lui-même : la fiche établissement de BaseLayout (même @id).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titre,
  description,
  datePublished: dateIso(date),
  inLanguage: 'fr',
  url: siteUrl + Astro.url.pathname,
  mainEntityOfPage: siteUrl + Astro.url.pathname,
  image: `${siteUrl}/og/lum.png`,
  author: { '@id': `${siteUrl}/#cafe` },
  publisher: { '@id': `${siteUrl}/#cafe` },
};
---

<BaseLayout title={`${titre} — LÜM Vieux-Lille`} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    is:inline
  />

  <div class="page">
    <Entete retour="/actus" />

    <article class="carte billet">
      <p class="chip">Actus</p>

      <header class="billet__entete">
        <h1>{titre}</h1>
        <p class="billet__meta">
          <time datetime={dateIso(date)}>{dateLisible(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutesDeLecture(article.body)} min de lecture</span>
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    <p class="suite">
      <a class="lum-pill-btn lum-pill-btn--inverse" href="/actus">
        <span class="arrow arrow--retour">←</span> Toutes les actus
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .carte {
    position: relative;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--edge-light), var(--elevation-3);
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche chevauche le bord de la carte, comme sur l'accueil. */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 9px 26px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--elevation-2);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .billet {
    margin-top: 30px;
    padding: 64px 56px 48px;
  }

  .billet__entete {
    margin-bottom: 32px;
    padding-bottom: 26px;
    border-bottom: 2px solid var(--cream-dark);
    text-align: center;
  }

  .billet h1 {
    max-width: 20ch;
    margin: 0 auto;
    font-size: clamp(2rem, 5.5vw, 3rem);
    text-wrap: balance;
  }

  .billet__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
    margin-top: 16px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brown);
  }

  /* --- Le texte de l'article, écrit en Markdown : ses balises viennent du
     rendu, hors de la portée des styles scopés, d'où les :global(). --- */
  .prose {
    max-width: 62ch;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--brown);
  }

  .prose > :global(* + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 1.9em;
    font-size: clamp(1.5rem, 4vw, 1.9rem);
    color: var(--terracotta);
  }

  .prose :global(h2 + *) {
    margin-top: 0.6em;
  }

  .prose :global(strong) {
    font-weight: 900;
    color: var(--terracotta);
  }

  .prose :global(ul) {
    padding-left: 0;
    list-style: none;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  /* Puce : une pastille terre cuite claire, comme les filets du site. */
  .prose :global(li)::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--terracotta-light);
  }

  .prose :global(a) {
    color: var(--terracotta);
    font-weight: 800;
    border-bottom: 2px solid var(--terracotta-light);
    transition: border-color 0.2s;
  }

  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    border-bottom-color: var(--terracotta);
  }

  .suite {
    text-align: center;
  }

  .suite .lum-pill-btn:hover .arrow--retour {
    transform: translateX(-4px);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .billet {
      padding: 56px 22px 32px;
    }

    .prose {
      font-size: 1rem;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Entete from '../components/Entete.astro';
import Trinquer from '../components/Trinquer.astro';
import { PRIX_PAR_PERSONNE, inclus, euros } from '../data/afterwork';

// L'unique appel à l'action de la page : il mène au paiement.
const RESERVER = '/afterwork/reservation';

// Même numéro que la fiche JSON-LD de BaseLayout et que llms.txt.
const TELEPHONE = 'tel:+33642996242';
const TELEPHONE_LISIBLE = '06 42 99 62 42';
// ig.me ouvre directement une conversation privée avec le compte, dans
// l'application comme sur le web.
const INSTAGRAM = 'https://ig.me/m/lum_vieuxlille';
const ITINERAIRE =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent('LÜM, 94 rue Saint-André, 59800 Lille');

// Le texte ne promet que ce que la boutique a confirmé : le jeudi,
// 18h30 – 22h30, l'adresse, 20 personnes, un serveur dédié, 29 € par
// personne, bière et trois planches.
const atouts = [
  {
    titre: '20 personnes',
    texte: 'Le café entier, privatisé pour votre groupe, jusqu\u2019à 20 personnes.',
    // Deux silhouettes
    trace:
      'M12.5 7.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M16 4.6a3.2 3.2 0 0 1 0 6.3 M18 14.3c1.8.7 3 2.5 3 4.7',
  },
  {
    titre: '1 serveur dédié',
    texte: 'Un serveur s\u2019occupe de votre groupe, et de lui seul, toute la soirée. Vous, vous profitez.',
    // Cloche de service
    trace: 'M3 17h18 M5 17a7 7 0 0 1 14 0 M12 10V7.5 M10 7.5h4 M5 20.5h14',
  },
  {
    titre: 'En plein Vieux-Lille',
    texte:
      'Au 94 rue Saint-André, au cœur du Vieux-Lille\u00a0: de quoi donner envie de quitter le bureau à l\u2019heure.',
    // Repère, comme l'adresse de l'accueil
    trace: 'M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z M14.6 10a2.6 2.6 0 1 1-5.2 0 2.6 2.6 0 0 1 5.2 0Z',
  },
];

const etapes = [
  {
    titre: 'Réservez votre jeudi',
    texte: 'Choisissez la date et le nombre de personnes, puis réglez en ligne.',
  },
  {
    titre: 'On s\u2019occupe de tout',
    texte: 'Bière, planches apéro, dînatoire et dessert\u00a0: tout est prévu.',
  },
  {
    titre: 'Vous n\u2019avez plus qu\u2019à venir',
    texte: 'Rendez-vous à 18h30 au 94 rue Saint-André. On s\u2019occupe du reste.',
  },
];
---

<BaseLayout
  title="Afterwork privatisé — LÜM Vieux-Lille"
  description="Privatisez le LÜM pour votre afterwork : tous les jeudis de 18h30 à 22h30, le café du 94 rue Saint-André, dans le Vieux-Lille, rien que pour votre équipe."
>
  <div class="page">
    <Entete />

    <!-- Accroche : la promesse, le créneau, le prix et l'unique bouton -->
    <section class="carte hero">
      <p class="chip">Afterwork privatisé</p>

      <span class="hero__icone"><Trinquer /></span>

      <h1>Le LÜM, rien que pour votre équipe</h1>
      <p class="script">Le jeudi, on lüm tard&nbsp;!</p>

      <p class="lede">De 18h30 à 22h30, le café de la rue Saint-André devient le vôtre.</p>

      <ul class="reperes">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </svg>
          Tous les jeudis, 18h30 – 22h30
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </svg>
          94 rue Saint-André, Lille
        </li>
      </ul>

      <div class="actions">
        <a class="lum-pill-btn lum-pill-btn--plein" href={RESERVER}>
          Réserver maintenant <span class="arrow">→</span>
        </a>
      </div>
      <p class="numero">{euros(PRIX_PAR_PERSONNE)} par personne</p>
    </section>

    <!-- Les raisons de choisir le lieu -->
    <section class="section">
      <h2 class="titre-section">Pourquoi le LÜM&nbsp;?</h2>

      <div class="atouts">
        {
          atouts.map((atout) => (
            <article class="carte carte--petite atout">
              <span class="atout__icone">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={atout.trace} />
                </svg>
              </span>
              <h3>{atout.titre}</h3>
              <p>{atout.texte}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- L'offre : un prix unique et ce qu'il comprend -->
    <section class="section">
      <h2 class="titre-section">Une formule, un prix</h2>

      <div class="carte offre">
        <p class="offre__prix">
          <span class="offre__montant">{euros(PRIX_PAR_PERSONNE)}</span>
          <span class="offre__unite">par personne</span>
        </p>

        <ul class="offre__inclus">
          {
            inclus.map((ligne) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M7.5 12.3l3 3 6-6.3" />
                </svg>
                <div>
                  <strong>{ligne.titre}</strong>
                  <span>{ligne.texte}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <a class="lum-pill-btn lum-pill-btn--plein" href={RESERVER}>
          Réserver maintenant <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <!-- Le déroulé, en trois temps -->
    <section class="section">
      <h2 class="titre-section">Comment ça se passe&nbsp;?</h2>

      <ol class="etapes">
        {
          etapes.map((etape, i) => (
            <li class="carte carte--petite etape">
              <span class="etape__numero" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Infos pratiques -->
    <section class="carte infos">
      <h2>Infos pratiques</h2>

      <dl>
        <div>
          <dt>Quand</dt>
          <dd>Tous les jeudis, de 18h30 à 22h30</dd>
        </div>
        <div>
          <dt>Groupe</dt>
          <dd>Jusqu'à 20 personnes, avec un serveur dédié</dd>
        </div>
        <div>
          <dt>Prix</dt>
          <dd>{euros(PRIX_PAR_PERSONNE)} par personne</dd>
        </div>
        <div>
          <dt>Où</dt>
          <dd>
            94 rue Saint-André, 59800 Lille
            <a href={ITINERAIRE} target="_blank" rel="noopener noreferrer">
              Itinéraire <span class="arrow">→</span>
            </a>
          </dd>
        </div>
        <div>
          <dt>Une question&nbsp;?</dt>
          <dd>
            <a href={TELEPHONE}>{TELEPHONE_LISIBLE}</a>
            <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
              Instagram <span class="arrow">→</span>
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <!-- Dernier appel -->
    <section class="carte final">
      <h2>Un jeudi vous fait de l'œil&nbsp;?</h2>
      <p class="lede">
        Choisissez votre date, indiquez le nombre de personnes&nbsp;: votre soirée est réservée.
      </p>
      <div class="actions">
        <a class="lum-pill-btn lum-pill-btn--plein" href={RESERVER}>
          Réserver maintenant <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* --- Cartes crème qui flottent sur la terre cuite --- */
  .carte {
    position: relative;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--edge-light), var(--elevation-3);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Les petites cartes, plus nombreuses, flottent un cran plus bas. */
  .carte--petite {
    padding: 28px 26px;
    box-shadow: var(--edge-light), var(--elevation-2);
  }

  .carte h2 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
  }

  .titre-section {
    margin-bottom: 26px;
    text-align: center;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    color: var(--cream);
  }

  .lede {
    max-width: 52ch;
    margin: 0 auto;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 28px;
  }

  /* --- Accroche --- */
  .hero {
    margin-top: 30px;
    padding: 70px 40px 40px;
  }

  /* Le cartouche chevauche le bord de la carte, comme sur l'accueil. */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 9px 26px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--elevation-2);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__icone {
    display: block;
    width: 104px;
    height: 104px;
    margin: 0 auto 18px;
  }

  .hero h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(2.3rem, 7vw, 3.6rem);
    text-wrap: balance;
  }

  .script {
    margin: 10px 0 18px;
    font-family: var(--font-script);
    font-size: 1.7rem;
    line-height: 1.2;
  }

  .reperes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .reperes li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--cream-dark);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .reperes svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .numero {
    margin-top: 14px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brown);
  }

  /* --- Atouts --- */
  .atouts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .atout {
    text-align: left;
  }

  .atout:nth-child(2) {
    animation-delay: 0.08s;
  }

  .atout:nth-child(3) {
    animation-delay: 0.16s;
  }

  .atout__icone {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--cream);
    box-shadow: var(--elevation-1);
  }

  .atout__icone svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .atout h3,
  .etape h3 {
    margin-bottom: 8px;
    font-size: 1.35rem;
  }

  .atout p,
  .etape p {
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--brown);
  }

  /* --- L'offre --- */
  .offre__prix {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 26px;
  }

  .offre__montant {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 12vw, 5rem);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .offre__unite {
    margin-top: 6px;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brown);
  }

  .offre__inclus {
    display: grid;
    gap: 16px;
    max-width: 460px;
    margin: 0 auto 30px;
    padding: 24px 0 0;
    border-top: 2px solid var(--cream-dark);
    list-style: none;
    text-align: left;
  }

  .offre__inclus li {
    display: flex;
    gap: 14px;
  }

  .offre__inclus svg {
    width: 26px;
    height: 26px;
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .offre__inclus div {
    display: flex;
    flex-direction: column;
  }

  .offre__inclus strong {
    font-weight: 900;
    font-size: 1.05rem;
  }

  .offre__inclus span {
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--brown);
  }

  /* --- Étapes --- */
  .etapes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Double classe : ce padding haut nul doit primer sur celui des
     petites cartes, y compris sur mobile. */
  .carte.etape {
    padding-top: 0;
    margin-top: 24px;
  }

  .etape:nth-child(2) {
    animation-delay: 0.08s;
  }

  .etape:nth-child(3) {
    animation-delay: 0.16s;
  }

  /* Le numéro chevauche le haut de la carte, comme les cartouches. */
  .etape__numero {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: -26px auto 16px;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    box-shadow: var(--elevation-2);
  }

  /* --- Infos pratiques --- */
  .infos {
    text-align: left;
  }

  .infos h2 {
    margin-bottom: 20px;
  }

  .infos dl {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .infos dl div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding-top: 14px;
    border-top: 2px solid var(--cream-dark);
  }

  .infos dt {
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brown);
  }

  .infos dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin: 0;
    font-weight: 800;
  }

  .infos a {
    border-bottom: 2px solid var(--terracotta-light);
    transition: border-color 0.2s;
  }

  .infos a:hover,
  .infos a:focus-visible {
    border-bottom-color: var(--terracotta);
  }

  .infos .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .infos a:hover .arrow {
    transform: translateX(3px);
  }

  /* --- Dernier appel --- */
  .final h2 {
    margin-bottom: 12px;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .page {
      gap: 46px;
    }

    .carte {
      padding: 32px 22px;
    }

    .hero {
      padding: 60px 22px 32px;
    }

    .carte--petite {
      padding: 24px 22px;
    }

    .atouts,
    .etapes {
      grid-template-columns: 1fr;
    }

    .etapes {
      gap: 34px;
    }

    .infos dl div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>

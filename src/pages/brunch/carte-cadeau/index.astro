---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Entete from '../../../components/Entete.astro';
import { PRIX_CENTIMES, QUANTITE_MAX } from '../../../../api/_lib/config.ts';

// Commande d'une carte cadeau brunch. Le formulaire part vers la fonction
// Vercel /api/carte-cadeau/commander, qui crée la commande chez Square et
// renvoie vers la page de paiement Square. Au retour, /brunch/carte-cadeau/merci/
// fait vérifier le paiement et envoyer la carte en PDF par e-mail.
//
// Prix et quantité maximale viennent de api/_lib/config.ts, comme pour le
// serveur ; les longueurs de champs y sont redites (LIMITES) et revérifiées.
const prix = PRIX_CENTIMES / 100;

// Tant que Square tourne en bac à sable, la page le dit (variable lue au build).
const test = import.meta.env.PUBLIC_SQUARE_ENV !== 'production';

const inclus = ['Un salé', 'Un sucré', 'Une boisson chaude', 'Une boisson froide'];
---

<BaseLayout
  title="Offrir le brunch — Carte cadeau LÜM Vieux-Lille"
  description="Offrez un ou plusieurs brunchs au LÜM Vieux-Lille : une carte cadeau à 25 € le brunch, envoyée par e-mail en PDF avec votre petit mot, valable un an."
>
  <div class="page">
    <Entete retour="/brunch/" />

    {
      test && (
        <p class="test">
          <span class="test__pastille">Mode test</span>
          Paiement Square en bac à sable&nbsp;: carte 4111 1111 1111 1111, date future, n'importe quel cryptogramme.
        </p>
      )
    }

    <div class="intro">
      <h1 class="titre-page">Offrir le brunch</h1>
      <p class="script">Une carte cadeau, et ton petit mot dessus</p>
    </div>

    <form class="commande" method="post" action="/api/carte-cadeau/commander" data-commande data-prix={prix}>
      <div class="blocs">
        <fieldset class="carte bloc">
          <legend><span class="num" aria-hidden="true">1</span> Tes coordonnées</legend>

          <div class="champs champs--deux">
            <label class="champ">
              <span class="champ__libelle">Prénom</span>
              <input name="prenom" autocomplete="given-name" maxlength="60" required />
            </label>
            <label class="champ">
              <span class="champ__libelle">Nom</span>
              <input name="nom" autocomplete="family-name" maxlength="60" required />
            </label>
            <label class="champ">
              <span class="champ__libelle">E-mail</span>
              <input name="email" type="email" autocomplete="email" maxlength="120" required />
              <span class="champ__aide">La carte t'y est envoyée.</span>
            </label>
            <label class="champ">
              <span class="champ__libelle">Téléphone</span>
              <input name="telephone" type="tel" autocomplete="tel" maxlength="25" required />
            </label>
          </div>
        </fieldset>

        <fieldset class="carte bloc">
          <legend><span class="num" aria-hidden="true">2</span> La carte</legend>

          <div class="champs">
            <label class="champ">
              <span class="champ__libelle">Pour qui&nbsp;? (facultatif)</span>
              <input name="pour" autocomplete="off" maxlength="60" placeholder="Son prénom" />
              <span class="champ__aide">La carte dira «&nbsp;Un brunch pour…&nbsp;».</span>
            </label>
            <label class="champ">
              <span class="champ__libelle">Ton petit mot (facultatif)</span>
              <textarea
                name="mot"
                rows="4"
                maxlength="250"
                placeholder="Joyeux anniversaire ! Un brunch rien que pour toi…"
                data-mot></textarea>
              <span class="champ__aide">Écrit à la main sur la carte. <span data-compteur>250</span> caractères restants.</span>
            </label>
          </div>
        </fieldset>
      </div>

      <aside class="carte recap">
        <h2>Récapitulatif</h2>

        <p class="recap__offre">Carte cadeau brunch</p>
        <p class="recap__lieu">Le week-end, 11h – 15h30 · <span class="insecable">94 rue Saint-André</span></p>

        <ul class="recap__inclus">
          {inclus.map((ligne) => <li>{ligne}</li>)}
        </ul>

        <!-- Sans script, le champ numérique suffit ; les boutons − et + ne
             font que l'incrémenter. -->
        <div class="quantite">
          <label class="champ__libelle" for="quantite">Brunchs offerts</label>
          <div class="stepper">
            <button type="button" class="stepper__btn" data-moins aria-label="Un brunch de moins">−</button>
            <input
              id="quantite"
              name="quantite"
              type="number"
              inputmode="numeric"
              min="1"
              max={QUANTITE_MAX}
              value="1"
              required
              data-quantite
            />
            <button type="button" class="stepper__btn" data-plus aria-label="Un brunch de plus">+</button>
          </div>
        </div>

        <p class="recap__ligne">
          <span data-detail>1 × {prix}&nbsp;€</span>
          <span data-sous-total>{prix}&nbsp;€</span>
        </p>
        <p class="recap__total">
          <span>Total</span>
          <strong data-total>{prix}&nbsp;€</strong>
        </p>

        <p class="erreur" role="alert" data-erreur hidden></p>

        <button class="lum-pill-btn lum-pill-btn--plein recap__payer" type="submit" data-payer>
          <span data-payer-texte>Payer {prix}&nbsp;€</span>
          <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="recap__note">
          Paiement sécurisé par Square. La carte arrive par e-mail, en PDF, dès le paiement validé. Valable un an.
        </p>
      </aside>
    </form>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-commande]')!;
  const payer = form.querySelector<HTMLButtonElement>('[data-payer]')!;
  const payerTexte = form.querySelector<HTMLElement>('[data-payer-texte]')!;
  const erreur = form.querySelector<HTMLElement>('[data-erreur]')!;
  const mot = form.querySelector<HTMLTextAreaElement>('[data-mot]')!;
  const compteur = form.querySelector<HTMLElement>('[data-compteur]')!;

  const majCompteur = () => {
    compteur.textContent = String(mot.maxLength - mot.value.length);
  };
  mot.addEventListener('input', majCompteur);
  majCompteur();

  // Quantité : boutons − et +, total et bouton de paiement suivent.
  const prix = Number(form.dataset.prix);
  const quantite = form.querySelector<HTMLInputElement>('[data-quantite]')!;
  const moins = form.querySelector<HTMLButtonElement>('[data-moins]')!;
  const plus = form.querySelector<HTMLButtonElement>('[data-plus]')!;
  const min = Number(quantite.min);
  const max = Number(quantite.max);
  const euros = (n: number) => `${n}\u00a0€`;

  function lireQuantite(): number {
    const n = Math.round(Number(quantite.value));
    return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : min;
  }

  function majMontant() {
    const n = lireQuantite();
    form.querySelector('[data-detail]')!.textContent = `${n} × ${euros(prix)}`;
    form.querySelector('[data-sous-total]')!.textContent = euros(n * prix);
    form.querySelector('[data-total]')!.textContent = euros(n * prix);
    payerTexte.textContent = `Payer ${euros(n * prix)}`;
    moins.disabled = n <= min;
    plus.disabled = n >= max;
  }

  function changer(delta: number) {
    quantite.value = String(lireQuantite() + delta);
    majMontant();
  }

  moins.addEventListener('click', () => changer(-1));
  plus.addEventListener('click', () => changer(1));
  quantite.addEventListener('input', majMontant);
  // En quittant le champ, une saisie hors bornes est ramenée entre 1 et le max.
  quantite.addEventListener('change', () => {
    quantite.value = String(lireQuantite());
    majMontant();
  });
  majMontant();

  // Sans script, le formulaire part tel quel et la fonction redirige vers
  // Square. Avec, on reste sur la page pour afficher une erreur éventuelle.
  form.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();
    erreur.hidden = true;
    payer.disabled = true;
    payerTexte.textContent = 'Redirection vers Square…';

    try {
      const reponse = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const resultat = (await reponse.json()) as { url?: string; orderId?: string; erreur?: string };
      if (!resultat.url) throw new Error(resultat.erreur ?? 'Une erreur est survenue.');
      // Secours pour la page de retour, si l'adresse revient de Square sans
      // numéro de commande : le paiement se fait dans le même onglet.
      try {
        if (resultat.orderId) sessionStorage.setItem('lum-carte-cadeau-commande', resultat.orderId);
      } catch {}
      window.location.href = resultat.url;
    } catch (e) {
      erreur.textContent =
        e instanceof Error && e.message !== 'Failed to fetch'
          ? e.message
          : 'Connexion impossible. Vérifie ta connexion et réessaie.';
      erreur.hidden = false;
      payer.disabled = false;
      majMontant();
    }
  });

  // Retour arrière depuis Square : la page sort du cache avec le bouton figé.
  window.addEventListener('pageshow', () => {
    payer.disabled = false;
    majMontant();
  });
</script>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 28px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .intro {
    text-align: center;
    color: var(--cream);
  }

  .titre-page {
    font-size: clamp(2.4rem, 8vw, 4rem);
  }

  .script {
    margin-top: 6px;
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  /* --- Bandeau du mode test --- */
  .test {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
    padding: 12px 18px;
    border: 2px dashed rgba(249, 241, 230, 0.6);
    border-radius: var(--radius);
    color: var(--cream);
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.5;
    text-align: center;
  }

  .test__pastille {
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--terracotta);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* --- Cartes --- */
  .carte {
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--edge-light), var(--elevation-3);
    animation: fade-up 0.5s ease both;
  }

  .commande {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 28px;
    align-items: start;
  }

  .blocs {
    display: grid;
    gap: 22px;
  }

  .bloc {
    min-width: 0;
    margin: 0;
    border: 0;
  }

  .bloc + .bloc {
    animation-delay: 0.1s;
  }

  /* La légende flotte pour se placer comme un titre ordinaire. */
  .bloc legend {
    float: left;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 20px;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .bloc legend + * {
    clear: both;
  }

  .num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--cream);
    font-size: 1.05rem;
    box-shadow: var(--elevation-1);
  }

  /* --- Champs --- */
  .champs {
    display: grid;
    gap: 16px;
  }

  .champs--deux {
    grid-template-columns: 1fr 1fr;
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .champ__libelle {
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown);
  }

  .champ__aide {
    margin-top: 2px;
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--brown);
  }

  input,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--terracotta-light);
    border-radius: 12px;
    background: #fffaf3;
    color: var(--terracotta);
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  /* Le petit mot s'écrit dans la police manuscrite de la carte. */
  textarea {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-script);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--terracotta-light);
    opacity: 0.8;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(196, 113, 74, 0.3);
  }

  /* --- Récapitulatif : il suit le défilement sur ordinateur --- */
  .recap {
    position: sticky;
    top: 24px;
    animation-delay: 0.15s;
  }

  .recap h2 {
    margin-bottom: 16px;
    font-size: 1.6rem;
  }

  .recap__offre {
    font-weight: 900;
    font-size: 1.05rem;
  }

  .recap__lieu {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brown);
  }

  .insecable {
    white-space: nowrap;
  }

  .recap__inclus {
    display: grid;
    gap: 6px;
    margin: 16px 0;
    padding: 16px 0 0;
    border-top: 2px solid var(--cream-dark);
    list-style: none;
  }

  .recap__inclus li {
    position: relative;
    padding-left: 20px;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--brown);
  }

  .recap__inclus li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.6em;
    width: 7px;
    height: 7px;
    background: var(--terracotta);
    transform: rotate(45deg);
  }

  /* --- Quantité : − [n] + --- */
  .quantite {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    margin-bottom: 14px;
    border-top: 2px solid var(--cream-dark);
  }

  .stepper {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--terracotta-light);
    border-radius: 999px;
    background: #fffaf3;
  }

  .stepper__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--terracotta);
    font: inherit;
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .stepper__btn:hover:not(:disabled) {
    background: var(--terracotta);
    color: var(--cream);
  }

  .stepper__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .stepper input {
    width: 3ch;
    padding: 6px 0;
    border: 0;
    background: none;
    text-align: center;
    font-weight: 900;
    font-size: 1.2rem;
    box-shadow: none;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .stepper input::-webkit-outer-spin-button,
  .stepper input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .stepper input:focus {
    box-shadow: none;
  }

  .stepper:focus-within {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(196, 113, 74, 0.3);
  }

  .recap__ligne,
  .recap__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .recap__ligne {
    font-weight: 700;
  }

  .recap__total {
    margin: 10px 0 20px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .recap__total strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.2rem;
    letter-spacing: 0.02em;
  }

  .recap__payer {
    width: 100%;
    justify-content: center;
  }

  .recap__payer:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
    box-shadow: none;
  }

  .recap__note {
    margin-top: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--brown);
  }

  .erreur {
    margin-bottom: 14px;
    padding: 10px 14px;
    border: 2px solid var(--terracotta);
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .erreur[hidden] {
    display: none;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .commande {
      grid-template-columns: 1fr;
    }

    .recap {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .carte {
      padding: 24px 20px;
    }

    .champs--deux {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';

// Le menu vit désormais sur Canva. Le domaine porte un « ü » : on écrit sa
// forme punycode, qui passe partout sans dépendre de l'encodage de l'URL.
const MENU = 'https://xn--lm-xka.my.canva.site/l-m/menu';
const RESERVATION = 'https://lumvieuxlille-hash.github.io/lum-vieuxlille/';
const LILLE_CENTRE = 'https://leo2662.github.io/lillecentre';
const AVIS =
  'https://search.google.com/local/writereview?placeid=ChIJzXLWKBcrw0cRI0DdWOWtaRM';

// Étoile pleine, tracée une fois et répétée cinq fois.
const ETOILE =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45-4.7-4.6 6.5-.95z';

const liens = [
  {
    nom: 'Instagram',
    url: 'https://www.instagram.com/lum_vieuxlille',
    // Appareil photo au trait, dans l'esprit des illustrations de l'affiche
    trace:
      'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17.4 6.6h.01',
  },
  {
    nom: 'TikTok',
    url: 'https://www.tiktok.com/@lum_vieuxlille',
    trace:
      'M14 3v12.2a3.8 3.8 0 1 1-3.2-3.75 M14 3c.4 2.6 2 4.2 4.6 4.5',
  },
];
---

<BaseLayout>
  <main class="stage">
    <a class="banniere" href={LILLE_CENTRE} target="_blank" rel="noopener noreferrer">
      <span class="banniere__pastille">Nouveau</span>
      <span>Ouverture du LÜM Lille Centre le jeudi 17 septembre <span class="arrow">→</span></span>
    </a>

    <section class="panel">
      <div class="chip">
        <h1>Healthy and Local</h1>
      </div>

      <p class="script">On va lümer&nbsp;?</p>

      <svg class="cup" viewBox="0 0 120 110" role="img" aria-label="Tasse de café">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 34h68v34a26 26 0 0 1-26 26H44a26 26 0 0 1-26-26V34Z" />
          <path d="M86 44h10a14 14 0 0 1 0 28h-10" />
          <path d="M22 40h60" />
          <path d="M38 22c0-6 6-8 6-14" />
          <path d="M54 22c0-6 6-8 6-14" />
          <path d="M70 22c0-6 6-8 6-14" />
        </g>
      </svg>

      <p class="lede">Coffee Shop &amp; Brunch Healthy</p>

      <p class="adresse">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
            <circle cx="12" cy="10" r="2.6" />
          </g>
        </svg>
        94 rue Saint-André, Lille
      </p>

      <p class="horaires">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5.2l3.4 2" />
          </g>
        </svg>
        Du mercredi au lundi, 10h – 18h
      </p>

      <div class="actions">
        <a class="lum-pill-btn" href={MENU} target="_blank" rel="noopener noreferrer">
          Consulter le menu <span class="arrow">→</span>
        </a>
        <a class="lum-pill-btn" href={RESERVATION} target="_blank" rel="noopener noreferrer">
          Réserver <span class="arrow">→</span>
        </a>
      </div>

      <div class="reseaux">
        {
          liens.map((lien) => (
            <a
              class="reseau"
              href={lien.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`LÜM — ${lien.nom}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d={lien.trace}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{lien.nom}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="avis">
      <div class="avis__etoiles" aria-hidden="true">
        {
          [0, 1, 2, 3, 4].map(() => (
            <svg viewBox="0 0 24 24">
              <path d={ETOILE} fill="currentColor" />
            </svg>
          ))
        }
      </div>

      <h2>Ça vous a plu&nbsp;?</h2>

      <a class="lum-pill-btn" href={AVIS} target="_blank" rel="noopener noreferrer">
        Laisser un avis <span class="arrow">→</span>
      </a>
    </section>

    <footer class="pied">
      <p>
        {'Notre second lieu : '}
        <a href={LILLE_CENTRE} target="_blank" rel="noopener noreferrer">
          LÜM Lille Centre <span class="arrow">→</span>
        </a>
      </p>
    </footer>
  </main>
</BaseLayout>

<style>
  .stage {
    min-height: 100vh;
    padding: 40px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .banniere {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 100%;
    padding: 11px 22px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--terracotta);
    font-weight: 800;
    font-size: 0.95rem;
    text-align: center;
    box-shadow: var(--shadow);
    animation: fade-up 0.5s ease both;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .banniere:hover,
  .banniere:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .banniere__pastille {
    padding: 3px 11px;
    border-radius: 999px;
    background: var(--terracotta);
    color: var(--cream);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .banniere .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .banniere:hover .arrow {
    transform: translateX(3px);
  }

  /* Les deux appels à l'action, côte à côte puis empilés sur mobile. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .panel {
    position: relative;
    width: 100%;
    max-width: 820px;
    margin-top: 34px;
    padding: 88px 40px 64px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  /* Le cartouche du titre chevauche le bord du panneau, comme sur l'affiche */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 14px 34px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
  }

  .script {
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .cup {
    display: block;
    width: 150px;
    margin: 28px auto 24px;
    color: var(--terracotta);
  }

  /* flex et non inline-flex : sinon les lignes se suivent sur la même ligne
     au lieu de s'empiler */
  .adresse,
  .horaires {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .adresse {
    margin-bottom: 6px;
  }

  .horaires {
    margin-bottom: 30px;
    color: var(--brown);
  }

  .adresse svg,
  .horaires svg {
    width: 19px;
    height: 19px;
    flex: none;
  }

  .lede {
    max-width: 46ch;
    margin: 0 auto 26px;
    font-weight: 700;
    font-size: 1.05rem;
    text-wrap: balance;
  }

  /* --- Liens, dans le panneau crème --- */
  .reseaux {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 38px;
    padding-top: 26px;
    border-top: 2px solid var(--cream-dark);
  }

  .reseau {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 20px;
    border: 2.5px solid var(--terracotta);
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }

  .reseau svg {
    width: 20px;
    height: 20px;
  }

  .reseau:hover,
  .reseau:focus-visible {
    background: var(--terracotta);
    color: var(--cream);
  }

  /* --- Appel à l'avis Google --- */
  .avis {
    width: 100%;
    max-width: 820px;
    padding: 34px 32px 38px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--shadow);
    text-align: center;
    animation: fade-up 0.5s ease 0.1s both;
  }

  .avis__etoiles {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 14px;
    color: var(--terracotta);
  }

  .avis__etoiles svg {
    width: 27px;
    height: 27px;
  }

  .avis h2 {
    /* h2 est à margin 0 globalement : l'écart avant le bouton se reprend ici,
       il était porté par le paragraphe retiré. */
    margin-bottom: 24px;
    font-size: clamp(1.5rem, 4.5vw, 2.2rem);
  }

  /* Bouton plein plutôt qu'en contour : c'est l'action la plus appuyée de
     la page, elle doit se détacher des deux boutons du panneau. */
  .avis .lum-pill-btn {
    background: var(--terracotta);
    color: var(--cream);
  }

  .avis .lum-pill-btn:hover,
  .avis .lum-pill-btn:focus-visible {
    background: var(--terracotta-dark);
    border-color: var(--terracotta-dark);
  }

  /* --- Pied de page, sur la terre cuite --- */
  .pied {
    color: var(--cream);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }

  .pied a {
    border-bottom: 2px solid rgba(249, 241, 230, 0.45);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .pied a:hover,
  .pied a:focus-visible {
    border-bottom-color: var(--cream);
  }

  .pied .arrow {
    display: inline-block;
    transition: transform 0.2s;
  }

  .pied a:hover .arrow {
    transform: translateX(3px);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .panel {
      padding: 74px 22px 48px;
    }

    .chip {
      max-width: calc(100% - 32px);
      padding: 12px 22px;
    }

    .avis {
      padding: 28px 20px 30px;
    }
  }
</style>

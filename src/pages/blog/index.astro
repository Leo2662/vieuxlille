---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entete from '../../components/Entete.astro';
import { billets, dateLisible, dateIso, minutesDeLecture } from '../../lib/blog';

const articles = await billets();
---

<BaseLayout
  title="Blog — LÜM Vieux-Lille"
  description="Les nouvelles du LÜM, coffee shop & brunch healthy du 94 rue Saint-André, dans le Vieux-Lille : le brunch, les nouveautés et la vie du café."
>
  <div class="page">
    <Entete />

    <!-- Accroche -->
    <section class="carte hero">
      <p class="chip">Blog</p>

      <span class="hero__icone">
        <!-- Un carnet ouvert et son crayon, au trait, dans le style de Trinquer -->
        <svg
          viewBox="0 0 48 48"
          width="100%"
          height="100%"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M24 12c-4-3-10-4-17-3v29c7-1 13 0 17 3 4-3 10-4 17-3V9c-7-1-13 0-17 3Z" />
          <path d="M24 12v29" />
          <path d="M12 17c3-.4 5.5 0 7 .8 M12 23c3-.4 5.5 0 7 .8 M12 29c3-.4 5.5 0 7 .8" />
          <path d="M29 30l7-13 3 1.6-7 13-3.6 1.5Z" />
        </svg>
      </span>

      <h1>Les nouvelles du LÜM</h1>
      <p class="script">Fraîchement sorties du four&nbsp;!</p>

      <p class="lede">Le brunch, les nouveautés et la vie du café, rue Saint&#8209;André.</p>
    </section>

    <!-- Les articles, du plus récent au plus ancien -->
    <section class="section" aria-label="Articles">
      <ol class="articles">
        {
          articles.map((article) => (
            <li>
              <article class="carte carte--petite article">
                <p class="article__meta">
                  <time class="article__date" datetime={dateIso(article.data.date)}>
                    {dateLisible(article.data.date)}
                  </time>
                  <span>{minutesDeLecture(article.body)} min de lecture</span>
                </p>

                <h2 class="article__titre">
                  <a href={`/blog/${article.id}/`}>{article.data.titre}</a>
                </h2>
                <p class="article__resume">{article.data.description}</p>

                <span class="lum-pill-btn" aria-hidden="true">
                  Lire l’article <span class="arrow">→</span>
                </span>
              </article>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
    padding: 28px var(--gutter) 72px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* --- Cartes crème qui flottent sur la terre cuite, comme /presse --- */
  .carte {
    position: relative;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: var(--edge-light), var(--elevation-3);
    text-align: center;
    animation: fade-up 0.5s ease both;
  }

  .carte--petite {
    padding: 28px 30px;
    box-shadow: var(--edge-light), var(--elevation-2);
  }

  .lede {
    max-width: 52ch;
    margin: 0 auto;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: balance;
  }

  /* --- Accroche --- */
  .hero {
    margin-top: 30px;
    padding: 70px 40px 40px;
  }

  /* Le cartouche chevauche le bord de la carte, comme sur l'accueil. */
  .chip {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: calc(100% - 40px);
    padding: 9px 26px;
    border: 3px solid var(--terracotta-light);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--elevation-2);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__icone {
    display: block;
    width: 96px;
    height: 96px;
    margin: 0 auto 18px;
  }

  .hero h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(2.3rem, 7vw, 3.6rem);
    text-wrap: balance;
  }

  .script {
    margin: 10px 0 18px;
    font-family: var(--font-script);
    font-size: 1.7rem;
    line-height: 1.2;
  }

  /* --- Articles --- */
  .articles {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .articles li:nth-child(2) .article {
    animation-delay: 0.08s;
  }

  .articles li:nth-child(3) .article {
    animation-delay: 0.16s;
  }

  /* Toute la carte est cliquable : le lien du titre l'étend sur la carte
     entière (::after), sans imbriquer de lien dans un autre. */
  .article {
    text-align: left;
    transition: transform 0.25s, box-shadow 0.25s;
    /* Une fois l'apparition finie, l'animation lâche `transform` : sinon
       son état final l'emporterait sur le soulèvement au survol. */
    animation-fill-mode: backwards;
  }

  @media (hover: hover) {
    .article:hover {
      transform: var(--lift);
      box-shadow: var(--edge-light), var(--elevation-3);
    }

    .article:hover .lum-pill-btn {
      background: var(--terracotta);
      color: var(--cream);
    }

    .article:hover .lum-pill-btn .arrow {
      transform: translateX(4px);
    }
  }

  .article:focus-within {
    outline: 3px solid var(--cream);
    outline-offset: 4px;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-bottom: 14px;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--brown);
  }

  .article__date {
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--cream-dark);
    font-weight: 800;
    color: var(--terracotta);
    white-space: nowrap;
  }

  /* Le titre de l'article : en texte courant, pas en lettres d'affiche —
     un titre d'article se lit, il ne se crie pas. */
  .article__titre {
    margin-bottom: 8px;
    font-family: var(--font-body);
    font-weight: 900;
    font-size: 1.3rem;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    text-wrap: pretty;
  }

  .article__titre a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .article__titre a:focus-visible {
    outline: none;
  }

  .article__resume {
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--brown);
  }

  .article .lum-pill-btn {
    margin-top: 20px;
    padding: 9px 22px;
    font-size: 0.85rem;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .page {
      gap: 46px;
    }

    .carte {
      padding: 32px 22px;
    }

    .hero {
      padding: 60px 22px 32px;
    }

    .carte--petite {
      padding: 24px 22px;
    }

    .article__titre {
      font-size: 1.15rem;
    }
  }
</style>
